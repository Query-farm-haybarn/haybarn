#include <windows.h>

#define Q(x) #x
#define QUOTE(x) Q(x)

// Haybarn: Windows VERSIONINFO rebranded. Version macros (DUCKDB_*) are kept as
// they carry the upstream DuckDB version numbers Haybarn is built from.
VS_VERSION_INFO VERSIONINFO
	FILEVERSION DUCKDB_MAJOR_VERSION,DUCKDB_MINOR_VERSION,DUCKDB_PATCH_VERSION,DUCKDB_DEV_ITERATION
	PRODUCTVERSION DUCKDB_MAJOR_VERSION,DUCKDB_MINOR_VERSION,DUCKDB_PATCH_VERSION,DUCKDB_DEV_ITERATION
#ifdef DEBUG
	FILEFLAGSMASK VS_FF_DEBUG | VS_FF_PRERELEASE
#else
	FILEFLAGSMASK 0
#endif
	FILEOS VOS_NT_WINDOWS32
	FILETYPE VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "Comments",         "Haybarn shell, powered by DuckDB"
			VALUE "CompanyName",      "Query Farm LLC"

			VALUE "FileDescription",  "Haybarn shell"
			VALUE "FileVersion",      QUOTE(DUCKDB_VERSION)
			VALUE "InternalName",     "Haybarn shell"
			VALUE "LegalCopyright",   "Copyright 2026 Query Farm LLC. Powered by DuckDB, Copyright 2018-" QUOTE(DUCKDB_COPYRIGHT_YEAR) " Stichting DuckDB Foundation."

			VALUE "OriginalFilename", "haybarn.exe"
			VALUE "ProductName",      "Haybarn"
			VALUE "ProductVersion",   QUOTE(DUCKDB_VERSION)
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1252
	END
END

// Haybarn: the DuckDB logo icon must not be shipped (trademark). Restore a
// MAINICON line here pointing at a Haybarn icon once the brand assets exist.
