# name: test/sql/pg_catalog/pg_attribute.test
# description: Test pg_attribute function
# group: [pg_catalog]

query IIIIII nosort pg_attribute
SELECT * FROM pg_attribute

query IIIIII nosort pg_attribute
SELECT * FROM pg_catalog.pg_attribute

statement ok
CREATE TABLE integers(i integer)

query III
select relname, attname, attnum from pg_attribute join pg_class on (pg_attribute.attrelid=pg_class.oid) where relname='integers' and attnum>=0;
----
integers	i	1

# atttypid carries real PostgreSQL type OIDs that join to pg_type.oid.
# Regression for duckdb/duckdb#18933: atttypid previously held DuckDB's
# internal LogicalTypeId (e.g. DOUBLE=23) which either failed the standard
# pg_attribute.atttypid = pg_type.oid join or matched the wrong row
# (LogicalTypeId DOUBLE=23 collided with PG int4=23).
statement ok
CREATE TABLE typed_cols(a INTEGER, b DOUBLE, c VARCHAR, d BOOLEAN, e BIGINT, f DATE, g TIMESTAMP, h SMALLINT, i FLOAT, j DECIMAL(10,2))

query IT
SELECT a.atttypid, t.typname
FROM pg_attribute a JOIN pg_type t ON a.atttypid = t.oid
WHERE a.attrelid = (SELECT oid FROM pg_class WHERE relname='typed_cols') AND a.attnum > 0
ORDER BY a.attnum
----
23	int4
701	float8
1043	varchar
16	bool
20	int8
1082	date
1114	timestamp
21	int2
700	float4
1700	numeric

# format_type() resolves the real PG OIDs now carried by atttypid, including
# the precision/scale packed into atttypmod for DECIMAL.
query T
SELECT format_type(a.atttypid, a.atttypmod)
FROM pg_attribute a
WHERE a.attrelid = (SELECT oid FROM pg_class WHERE relname='typed_cols') AND a.attnum > 0
ORDER BY a.attnum
----
int4
float8
varchar
bool
int8
date
timestamp
int2
float4
numeric(10,2)
