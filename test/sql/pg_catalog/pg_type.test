# Array types are exposed with their element type (typelem) and category 'A',
# and each base scalar links to its array type via typarray. Clients (pgjdbc,
# DBeaver) resolve array columns by joining base.typarray -> array.oid and
# array.typelem -> base.oid; previously typelem/typarray were always NULL and
# no array rows existed.
query III
SELECT oid, typelem, typcategory FROM pg_type WHERE typname = '_int4'
----
1007	23	A

query III
SELECT oid, typelem, typcategory FROM pg_type WHERE typname = '_float8'
----
1022	701	A

# _text is provided explicitly (the engine has varchar, not text); its element
# type points at varchar so array element resolution lands on a real row.
query III
SELECT oid, typelem, typcategory FROM pg_type WHERE typname = '_text'
----
1009	1043	A

query I
SELECT typarray FROM pg_type WHERE typname = 'int4' AND oid IS NOT NULL
----
1007

query I
SELECT typarray FROM pg_type WHERE typname = 'varchar' AND oid IS NOT NULL
----
1015

# PostgreSQL declares these columns NOT NULL; strict drivers (Npgsql) read them
# as non-nullable and crash on a NULL. They must be concrete, never NULL.
query I
SELECT count(*) FROM pg_type WHERE typnotnull IS NULL
----
0

query I
SELECT count(*) FROM pg_type WHERE typdelim IS NULL
----
0

query I
SELECT count(*) FROM pg_type WHERE typinput IS NULL OR typoutput IS NULL OR typreceive IS NULL OR typsend IS NULL
----
0

query I
SELECT DISTINCT typnotnull FROM pg_type
----
false

query I
SELECT DISTINCT typdelim FROM pg_type
----
,

# Every row exposed has a non-NULL oid (rows the engine can't map to a PG oid are
# filtered out, not emitted with a NULL oid that breaks driver type-loading).
query I
SELECT count(*) FROM pg_type WHERE oid IS NULL
----
0

# Built-in types live in the pg_catalog schema, so a driver joining
# pg_type.typnamespace -> pg_namespace.oid resolves their qualified name as
# pg_catalog.<type> (not main.<type>), matching its built-in readers.
query I
SELECT n.nspname FROM pg_type t JOIN pg_namespace n ON n.oid = t.typnamespace WHERE t.typname = 'varchar'
----
pg_catalog

query I
SELECT n.nspname FROM pg_type t JOIN pg_namespace n ON n.oid = t.typnamespace WHERE t.typname = 'int4'
----
pg_catalog

# User-defined enums keep their real schema (not relocated to pg_catalog).
query I
SELECT n.nspname FROM pg_type t JOIN pg_namespace n ON n.oid = t.typnamespace WHERE t.typname = 'greeting'
----
main